# ---------------------------------------------------------------------------
# Thought Authorities — A.I. C-Suite
# Copy to .env.local. NEVER commit real values.
# When Supabase variables are absent the app runs in DEMO MODE
# (in-memory data store, simulated A.I. output clearly labelled as such).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret for demo-mode auth cookies (>= 32 chars).
# Optional on Netlify: if unset, a secret is generated once and stored in Netlify Database.
SESSION_SECRET=

# Supabase (production data, auth, storage, pgvector)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI providers (server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Credential encryption key for org-supplied provider keys (32 bytes, base64)
CREDENTIALS_ENCRYPTION_KEY=

# Observability / billing (optional)
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
